{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/preload/**/*.ts"
, "src/main/**/*.ts"  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron"
  ]
}